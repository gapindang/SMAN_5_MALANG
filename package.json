{
  "name": "sman-5-malang",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "set-admin-password": "node scripts/hash-password.mjs --write",
    "sync:icons": "node scripts/sync-icons.mjs",
    "test:cms": "node --test tests/*.integration.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "verify": "npm test && npm run test:cms && npm run check && npm run lint && npm run build"
  },
  "dependencies": {
    "astro": "^5.16.0",
    "@astrojs/vercel": "^8.2.0",
    "@astrojs/svelte": "^7.2.0",
    "svelte": "^5.43.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vercel/blob": "^2.8.2",
    "zod": "^4.1.0",
    "sanitize-html": "^2.17.0",
    "pdfjs-dist": "^5.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@astrojs/check": "^0.9.5",
    "@types/sanitize-html": "^2.16.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.3.5",
    "svelte-check": "^4.3.0"
  },
  "engines": {
    "node": "22.x"
  }
}
