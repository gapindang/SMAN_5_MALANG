# Copy to .env for local development. Never commit real credentials.
ADMIN_USERNAME=admin
# Generate with npm run hash-password (password: at least 12 characters).
# Keep the complete salt:hash value.
ADMIN_PASSWORD_HASH=
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Leave both tokens empty for local development with .data/ storage.
# Production: token of a PRIVATE Vercel Blob store for CMS data.
BLOB_READ_WRITE_TOKEN=
# Production: token of a separate PUBLIC Vercel Blob store for images/PDFs.
MEDIA_BLOB_READ_WRITE_TOKEN=

# Local: http://localhost:4321
# Production: https://your-project.vercel.app or your HTTPS custom domain.
# When empty on Vercel, the app uses VERCEL_PROJECT_PRODUCTION_URL.
PUBLIC_SITE_URL=
