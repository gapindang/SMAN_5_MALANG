---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import {school} from '../lib/school';
import {publicItems} from '../lib/storage';
import '../lib/home.css';
const news=(await publicItems('news')).slice(0,3);
const magazine=(await publicItems('magazines'))[0];
const moments=[
 {src:school.hero,title:'Di sinilah langkah kita dimulai.',label:'DHAMYSOGA',alt:'Gedung dan papan nama SMA Negeri 5 Malang'}
];
---
<Layout title={`${school.name} · Profil Sekolah`}>
<div class="home" id="beranda">
 <div class="reading-progress" aria-hidden="true"></div>
 <div class="earth-orbit orbit-one" aria-hidden="true"></div><div class="earth-orbit orbit-two" aria-hidden="true"></div>
 <section class="wrap home-hero" aria-labelledby="hero-title">
  <div class="hero-copy" data-reveal>
   <div class="eyebrow"><span class="living-dot" aria-hidden="true"></span>Selamat datang di {school.name}</div>
   <h1 id="hero-title">Akar yang kuat.<br/>Masa depan<br/>yang <em>berarti.</em><span class="title-spark" aria-hidden="true"><Icon name="sparkles"/></span></h1>
   <p class="hero-description">Kenali ruang tempat pengetahuan bertemu karakter.<br class="desktop"/> Tempat rasa ingin tahu tumbuh menjadi karya.</p>
   <div class="hero-actions"><a class="button" href="#kenali">Jelajahi sekolah <span aria-hidden="true"><Icon name="arrow-up-right"/></span></a><a class="quiet-link" href="/profil">Profil lengkap <span aria-hidden="true"><Icon name="arrow-right"/></span></a></div>
   <a class="scroll-cue" href="#kenali"><span class="scroll-track" aria-hidden="true"><Icon name="arrow-down" size={16}/></span><span>Scroll untuk mengenal kami<small>SEBUAH PERJALANAN BERTUMBUH</small></span></a>
  </div>
  <div class="hero-scene" data-reveal>
   <div class="scene-ring" aria-hidden="true"></div><span class="scene-coordinate" aria-hidden="true">BERAKAR · BERTUMBUH · BERMAKNA</span>
   <div class="hero-photo" data-tilt><img src={school.hero} alt="Gedung dan papan nama SMA Negeri 5 Malang" width="900" height="1050" fetchpriority="high"/><div class="photo-shade"></div><div class="photo-caption"><span>SEBUAH RUANG UNTUK MENJADI DIRI SENDIRI</span><strong>Di sini, cerita kita dimulai.</strong></div></div>
   <div class="glass floating-note note-top"><span class="note-icon" aria-hidden="true"><Icon name="arrow-up-right"/></span><div><small>SEMANGAT KAMI</small><strong>Belajar dengan makna.</strong></div></div>
   <a class="glass floating-note note-bottom" href="#nilai"><span class="leaf-mark" aria-hidden="true"><Icon name="leaf"/></span><div><small>TUMBUH SEUTUHNYA</small><strong>Pengetahuan. Karakter. Karya.</strong><span>Kenali nilai sekolah <span aria-hidden="true"><Icon name="arrow-up-right"/></span></span></div></a>
   <span class="image-credit">SMA Negeri 5 Malang · Dhamysoga</span>
  </div>
 </section>
 <div class="wrap" data-reveal><div class="glass school-facts">{school.stats.map(([n,label],i)=><div><span class="fact-index">0{i+1}</span><strong class:list={{'long-stat':n.length>4}}>{n}</strong><span>{label}</span></div>)}</div>{school.placeholder&&<p class="placeholder-note">PROFIL CONTOH · Identitas, foto, dan data sekolah menunggu informasi resmi.</p>}</div>
 <nav class="chapter-nav glass" aria-label="Jelajahi beranda"><a href="#kenali" aria-current="location">Kenali kami</a><a href="#nilai">Nilai sekolah</a><a href="#cerita">Cerita</a><a href="#momen">Momen</a></nav>
 <section class="section school-intro" id="kenali" aria-labelledby="intro-title"><div class="wrap intro-layout"><div data-reveal><div class="eyebrow">01 / Lebih dekat</div><h2 id="intro-title">Sebuah sekolah.<br/>Banyak cara untuk<br/><em>menemukan diri.</em></h2></div><div class="intro-copy" data-reveal><span class="intro-symbol" aria-hidden="true"><Icon name="sparkles"/></span><p>SMA Negeri 5 Malang, dikenal sebagai Dhamysoga, berdiri sejak 13 September 1965. Berlandaskan moto Dharme Kyastu Yogya, kami menumbuhkan kesederhanaan dan kerendahan hati sebagai dasar untuk berdarma bakti.</p><p class="muted">Jelajahi visi, lingkungan belajar, dan kehidupan sekolah. Temukan bagaimana pengetahuan, karakter, dan kreativitas tumbuh bersama.</p><a class="arrow-link" href="/profil">Mengenal {school.name} <span><Icon name="arrow-up-right"/></span></a></div></div></section>
 <section class="section values-section" id="nilai" aria-labelledby="values-title"><div class="wrap"><div class="section-head" data-reveal><div><div class="eyebrow">02 / Arah pertumbuhan</div><h2 id="values-title">Berakar pada nilai.<br/><em>Terbuka pada kemungkinan.</em></h2></div><p class="muted section-summary">Kenali hal-hal yang membentuk<br/>perjalanan belajar di sekolah kami.</p></div>
 <div class="glass values-panel" data-reveal><div class="profile-tabs" aria-label="Tentang sekolah"><button type="button" id="tab-visi" aria-controls="panel-visi" data-profile-tab="visi"><span>01</span> Visi kami <span aria-hidden="true"><Icon name="arrow-up-right"/></span></button><button type="button" id="tab-misi" aria-controls="panel-misi" data-profile-tab="misi"><span>02</span> Misi bersama <span aria-hidden="true"><Icon name="arrow-up-right"/></span></button><button type="button" id="tab-ruang" aria-controls="panel-ruang" data-profile-tab="ruang"><span>03</span> Ruang bertumbuh <span aria-hidden="true"><Icon name="arrow-up-right"/></span></button></div>
 <div class="profile-content"><section id="panel-visi" aria-labelledby="tab-visi" data-profile-panel="visi"><div class="eyebrow">Pandangan ke depan</div><h3>Menjadi berarti,<br/>dimulai dari sini.</h3><p>{school.vision}</p><span class="value-tag">Karakter yang kuat · Wawasan yang luas</span></section><section id="panel-misi" aria-labelledby="tab-misi" data-profile-panel="misi"><div class="eyebrow">Langkah yang kami percaya</div><h3>Belajar bersama.<br/>Tumbuh bersama.</h3><ol>{school.mission.map(m=><li>{m}</li>)}</ol></section><section id="panel-ruang" aria-labelledby="tab-ruang" data-profile-panel="ruang"><div class="eyebrow">Setiap potensi punya tempat</div><h3>Temukan minat.<br/>Beranikan langkah.</h3><p>Dari kegiatan akademik hingga seni, olahraga, dan organisasi, masa sekolah menjadi ruang untuk mengeksplorasi potensi.</p><p class="muted">Perpustakaan, laboratorium, Green House, sarana olahraga, tempat ibadah, dan UKS mendukung kegiatan belajar siswa.</p><a class="arrow-link" href="/profil">Jelajahi profil lengkap <Icon name="arrow-up-right"/></a></section></div><div class="values-art" aria-hidden="true"><div class="art-sun"></div><div class="art-hill hill-back"></div><div class="art-hill hill-front"></div><span>tumbuh.<br/><em>bersama.</em></span><small>BERAKAR KUAT, TUMBUH HEBAT</small></div></div></div></section>
 <section class="section home-news" id="cerita" aria-labelledby="news-title"><div class="wrap"><div class="section-head" data-reveal><div><div class="eyebrow">03 / Kehidupan sekolah</div><h2 id="news-title">Cerita kecil.<br/><em>Makna yang besar.</em></h2></div><a href="/berita" class="arrow-link">Semua berita <span><Icon name="arrow-up-right"/></span></a></div><div class="grid3">{news.map(item=><div class="glass story-surface" data-reveal><NewsCard item={item}/></div>)}</div>{!news.length&&<div class="glass home-empty" data-reveal><span aria-hidden="true"><Icon name="sparkles"/></span><div><h3>Ruang untuk cerita baru.</h3><p>Kabar, karya, dan momen sekolah akan hadir di sini setelah diterbitkan.</p></div><a class="arrow-link" href="/berita">Jelajahi berita <Icon name="arrow-up-right"/></a></div>}</div></section>
 {magazine&&<section class="section home-magazine"><div class="wrap magazine-layout glass" data-reveal><a class="magazine-cover" href={`/majalah/${magazine.slug}`} aria-label={`Baca ${magazine.title}`}><div class="cover-halo" aria-hidden="true"></div><img src={magazine.coverUrl} alt={`Sampul ${magazine.title}`} width="360" height="540" loading="lazy"/><span class="cover-sticker">DARI SISWA,<br/>UNTUK KITA.</span></a><div><div class="eyebrow">Suara dari ruang kelas</div><h2>Ide yang hidup.<br/><em>Cerita yang tinggal.</em></h2><p class="muted">Jendela kecil untuk melihat dunia dari sudut pandang siswa. Temukan karya dan inspirasi dalam setiap halaman.</p><div class="edition">EDISI {magazine.edition} <span>·</span> {magazine.year}</div><h3>{magazine.title}</h3><a class="button" href={`/majalah/${magazine.slug}`}>Buka majalah <span><Icon name="book-open"/></span></a><a class="quiet-link" href="/majalah">Semua edisi <Icon name="arrow-right"/></a></div></div></section>}
 <section class="section moments-section" id="momen" aria-labelledby="moments-title"><div class="wrap"><div class="section-head" data-reveal><div><div class="eyebrow">04 / Potret keseharian</div><h2 id="moments-title">Yang membuat sekolah<br/><em>terasa seperti rumah.</em></h2></div><p class="muted section-summary">Klik foto untuk melihat lebih dekat.<br/>Potret SMA Negeri 5 Malang.</p></div><div class="moments-grid">{moments.map((m,i)=><button class="moment" data-reveal type="button" data-moment-src={m.src} data-moment-title={m.title} data-moment-alt={m.alt} aria-label={`Perbesar foto: ${m.alt}`}><img src={m.src} alt={m.alt} width="700" height="850" loading="lazy"/><span class="moment-number">0{i+1}</span><span class="moment-caption"><small>{m.label}</small><strong>{m.title}</strong></span><span class="moment-open" aria-hidden="true"><Icon name="maximize-2"/></span></button>)}</div></div></section>
 <section class="home-invitation section"><div class="wrap" data-reveal><div class="invitation-mark" aria-hidden="true"><Icon name="sparkles"/></div><div class="eyebrow">Setiap perjalanan dimulai dari perkenalan</div><h2>Mari mengenal.<br/>Mari <em>bertumbuh.</em></h2><p>Temukan lebih banyak tentang sekolah kami.<br/>Kami senang menyambut rasa ingin tahumu.</p><a class="button" href="/kontak">Sapa kami <span><Icon name="mail"/></span></a><a class="quiet-link" href="/profil">Baca profil sekolah <Icon name="arrow-right"/></a></div><div class="invitation-ring" aria-hidden="true"></div></section>
 <a href="#beranda" class="back-top glass" aria-label="Kembali ke atas" hidden><Icon name="arrow-up"/></a>
 <dialog class="moment-dialog" aria-label="Potret keseharian sekolah"><button class="dialog-close" type="button" aria-label="Tutup foto"><Icon name="x"/></button><img src="/image-fallback.svg" alt="" width="1200" height="800"/><p></p><small>Potret SMA Negeri 5 Malang</small></dialog>
</div>
<script>
 const home=document.querySelector<HTMLElement>('.home');
 if(home){
  const motion=window.matchMedia('(prefers-reduced-motion: reduce)');
  const elements=Array.from(home.querySelectorAll<HTMLElement>('[data-reveal]'));
  if('IntersectionObserver' in window&&!motion.matches){
   const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target);}});},{threshold:.08,rootMargin:'0px 0px -25px 0px'});
   elements.forEach(el=>{el.classList.add('reveal-ready');observer.observe(el);});
   motion.addEventListener('change',()=>{if(motion.matches){elements.forEach(el=>el.classList.add('is-visible'));observer.disconnect();}});
  }
  const tabs=Array.from(home.querySelectorAll<HTMLButtonElement>('[data-profile-tab]'));
  const panels=Array.from(home.querySelectorAll<HTMLElement>('[data-profile-panel]'));
  home.querySelector('.profile-tabs')?.setAttribute('role','tablist');
  function selectTab(index:number,focus=false){tabs.forEach((tab,i)=>{tab.setAttribute('role','tab');tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;});panels.forEach((panel,i)=>{panel.setAttribute('role','tabpanel');panel.tabIndex=0;panel.hidden=i!==index;});if(focus)tabs[index].focus();}
  tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>selectTab(i));tab.addEventListener('keydown',e=>{let next=i;if(e.key==='ArrowRight'||e.key==='ArrowDown')next=(i+1)%tabs.length;else if(e.key==='ArrowLeft'||e.key==='ArrowUp')next=(i-1+tabs.length)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();selectTab(next,true);});});selectTab(0);
  const chapterLinks=Array.from(home.querySelectorAll<HTMLAnchorElement>('.chapter-nav a'));
  const chapters=chapterLinks.map(link=>home.querySelector<HTMLElement>(link.hash)).filter((section):section is HTMLElement=>!!section);
  const progress=home.querySelector<HTMLElement>('.reading-progress');const backTop=home.querySelector<HTMLElement>('.back-top');
  let framePending=false;
  function updateScroll(){const y=window.scrollY;const max=document.documentElement.scrollHeight-window.innerHeight;progress?.style.setProperty('--progress',String(max>0?Math.min(1,Math.max(0,y/max)):0));if(backTop)backTop.hidden=y<650;let current=chapters[0]?.id;chapters.forEach(section=>{if(section.getBoundingClientRect().top<window.innerHeight*.4)current=section.id;});chapterLinks.forEach(link=>{if(link.hash===`#${current}`)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');});framePending=false;}
  function queueScroll(){if(!framePending){framePending=true;requestAnimationFrame(updateScroll);}}
  window.addEventListener('scroll',queueScroll,{passive:true});window.addEventListener('resize',queueScroll,{passive:true});updateScroll();
  const photo=home.querySelector<HTMLElement>('[data-tilt]');
  if(photo){photo.addEventListener('pointermove',e=>{if(motion.matches||e.pointerType!=='mouse')return;const rect=photo.getBoundingClientRect();const x=(e.clientX-rect.left)/rect.width-.5;const y=(e.clientY-rect.top)/rect.height-.5;photo.style.setProperty('--tilt-x',`${-y*4}deg`);photo.style.setProperty('--tilt-y',`${x*4}deg`);});photo.addEventListener('pointerleave',()=>{photo.style.setProperty('--tilt-x','0deg');photo.style.setProperty('--tilt-y','0deg');});motion.addEventListener('change',()=>{photo.style.setProperty('--tilt-x','0deg');photo.style.setProperty('--tilt-y','0deg');});}
  const dialog=home.querySelector<HTMLDialogElement>('.moment-dialog');let lastMoment:HTMLButtonElement|null=null;
  function closeMoment(){dialog?.close();}
  if(dialog){home.querySelectorAll<HTMLButtonElement>('[data-moment-src]').forEach(button=>button.addEventListener('click',()=>{const img=dialog.querySelector('img')!;img.src=button.dataset.momentSrc!;img.alt=button.dataset.momentAlt!;dialog.querySelector('p')!.textContent=button.dataset.momentTitle!;lastMoment=button;dialog.showModal();document.body.classList.add('viewing-moment');}));dialog.querySelector('.dialog-close')?.addEventListener('click',closeMoment);dialog.addEventListener('click',e=>{if(e.target===dialog){const rect=dialog.getBoundingClientRect();if(e.clientX<rect.left||e.clientX>rect.right||e.clientY<rect.top||e.clientY>rect.bottom)closeMoment();}});dialog.addEventListener('close',()=>{document.body.classList.remove('viewing-moment');lastMoment?.focus();});}
 }
</script>
</Layout>
