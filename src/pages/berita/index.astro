---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';import NewsCard from '../../components/NewsCard.astro';import {publicItems} from '../../lib/storage';
const all=await publicItems('news');const query=Astro.url.searchParams.get('q')||'';const category=Astro.url.searchParams.get('kategori')||'';const filtered=all.filter(n=>n.title.toLocaleLowerCase('id').includes(query.toLocaleLowerCase('id'))&&(!category||n.category===category));const pages=Math.max(1,Math.ceil(filtered.length/9));const page=Math.min(pages,Math.max(1,Number.parseInt(Astro.url.searchParams.get('page')||'1')||1));const items=filtered.slice((page-1)*9,page*9);const categories=[...new Set(all.map(n=>n.category))];
---
<Layout title="Berita & Cerita"><div class="wrap"><div class="page-heading"><div class="eyebrow">Jurnal sekolah</div><h1>Cerita dari<br/>setiap sudut.</h1><p class="muted">Kabar terbaru, karya, dan momen yang memberi warna pada kehidupan sekolah.</p></div><form class="filters" role="search"><input aria-label="Cari judul berita" type="search" name="q" value={query} placeholder="Cari cerita yang ingin kamu baca…"/><select name="kategori" aria-label="Kategori berita"><option value="">Semua kategori</option>{categories.map(c=><option selected={category===c}>{c}</option>)}</select><button class="button">Cari <span><Icon name="search"/></span></button></form><p class="muted" style="font-size:11px">{filtered.length} cerita · Diurutkan dari yang terbaru</p><div class="grid3">{items.map(item=><NewsCard item={item}/>)}</div>{!items.length&&<div class="empty"><h3>{all.length?'Belum ada berita yang cocok.':'Belum ada berita.'}</h3><p>{all.length?'Coba kata kunci lain atau jelajahi semua berita.':'Berita sekolah akan tampil di sini setelah diterbitkan.'}</p>{all.length>0&&<a href="/berita" class="arrow-link">Reset pencarian <Icon name="arrow-right"/></a>}</div>}{pages>1&&<nav class="pagination" aria-label="Halaman berita">{Array.from({length:pages},(_,i)=><a class="pill" aria-current={page===i+1?'page':undefined} href={`?${new URLSearchParams({q:query,kategori:category,page:String(i+1)})}`}>{i+1}</a>)}</nav>}</div></Layout><style>.pagination{display:flex;justify-content:center;gap:12px;margin:50px 0}.pagination a[aria-current]{background:#30382d;color:#f5f0e6}</style>
