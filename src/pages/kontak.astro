---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';import {school} from '../lib/school';
---
<Layout title="Kontak Sekolah"><div class="wrap"><div class="page-heading"><div class="eyebrow">Pintu kami terbuka</div><h1>Mulai dengan<br/>sebuah <em>sapaan.</em></h1><p class="muted">Informasi dan pertanyaan tentang sekolah dapat disampaikan melalui kanal resmi berikut.</p></div><div class="contact-grid"><section><div class="eyebrow">Kunjungi & hubungi</div><h3>{school.name}</h3><p><a class="location-link" href={school.mapUrl} target="_blank" rel="noopener noreferrer">{school.address} <span aria-hidden="true"><Icon name="arrow-up-right"/></span></a></p><p><Icon name="mail" size={18}/> Email: {school.email?<a href={`mailto:${school.email}`}>{school.email}</a>:'Belum dikonfigurasi'}</p><p><Icon name="phone" size={18}/> Telepon: {school.phone?<a href={`tel:${school.phone}`}>{school.phone}</a>:'Belum dikonfigurasi'}</p><hr/><h3><Icon name="clock"/> Jam layanan</h3><p>{school.hours}</p><p class="muted">Contoh jam layanan — sesuaikan dengan operasional sekolah.</p></section><div class="map-panel"><span aria-hidden="true"><Icon name="map-pin" size={70}/></span><h3>Sampai jumpa di sekolah.</h3><p>{school.address}</p><a class="button" href={school.mapUrl} target="_blank" rel="noopener noreferrer">Buka Google Maps <span aria-hidden="true"><Icon name="arrow-up-right"/></span></a></div></div></div></Layout><style>.contact-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:70px;margin-bottom:80px}.contact-grid p{font-size:13px}.contact-grid hr{border:0;border-top:1px solid #cccdbf;margin:30px 0}.map-panel{background:#e3e6d7;display:flex;align-items:center;justify-content:center;flex-direction:column;min-height:380px;text-align:center;padding:25px}.map-panel>span{font-size:70px;color:#69785c}.map-panel p{font-size:12px;color:#65675b;max-width:340px}.map-panel .button{margin-top:12px}@media(max-width:900px){.contact-grid{grid-template-columns:1fr;gap:25px}}</style>
