---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';import {publicItems} from '../../lib/storage';
const all=await publicItems('magazines');const q=Astro.url.searchParams.get('q')||'';const year=Astro.url.searchParams.get('tahun')||'';const items=all.filter(m=>m.title.toLowerCase().includes(q.toLowerCase())&&(!year||String(m.year)===year));const years=[...new Set(all.map(m=>m.year))].sort((a,b)=>b-a);
---
<Layout title="Majalah Digital"><div class="wrap"><div class="page-heading"><div class="eyebrow">Perpustakaan karya siswa</div><h1>Halaman demi halaman.<br/>Cerita demi cerita.</h1><p class="muted">Arsip suara, gagasan, dan kreativitas siswa. Buka edisinya, temukan dunianya.</p></div><form class="filters" role="search"><input type="search" name="q" aria-label="Cari majalah" value={q} placeholder="Cari judul majalah…"/><select name="tahun" aria-label="Tahun terbit"><option value="">Semua tahun</option>{years.map(y=><option value={y} selected={String(y)===year}>{y}</option>)}</select><button class="button">Cari <span><Icon name="search"/></span></button></form><div class="mag-grid">{items.map(m=><article><a href={`/majalah/${m.slug}`}><div class="cover"><img src={m.coverUrl} alt={`Cover ${m.title}`} width="360" height="540" loading="lazy"/></div><div class="news-meta">EDISI {m.edition} <span>·</span> {m.year}</div><h3>{m.title}</h3><p class="muted">{m.description}</p><span class="arrow-link">Buka edisi <span><Icon name="arrow-up-right"/></span></span></a></article>)}</div>{!items.length&&<div class="empty"><h3>{all.length?'Belum ada edisi yang cocok.':'Belum ada majalah.'}</h3><p>{all.length?'Coba kata kunci atau tahun lain.':'Majalah sekolah akan tampil di sini setelah diterbitkan.'}</p>{all.length>0&&<a href="/majalah">Reset pencarian <Icon name="arrow-right"/></a>}</div>}</div></Layout><style>.mag-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:45px;margin:45px 0 80px}.cover{background:#e5e4d7;padding:30px}.cover img{width:100%;height:auto;aspect-ratio:2/3;box-shadow:8px 10px 15px #30382d25}.mag-grid p{font-size:12px}@media(min-width:761px) and (max-width:1024px){.mag-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.cover{padding:22px}}@media(max-width:760px){.mag-grid{grid-template-columns:1fr}.cover{max-width:380px}}</style>
