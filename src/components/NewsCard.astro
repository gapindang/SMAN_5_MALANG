---
const {item}=Astro.props;
---
<article class="news-card"><a href={`/berita/${item.slug}`}><img class="news-image" src={item.featuredImageUrl||'/image-fallback.svg'} alt={item.title} width="600" height="400" loading="lazy"/><div class="news-meta"><span>{item.category}</span><span>·</span><time datetime={item.publishedAt}>{new Date(item.publishedAt).toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'})}</time></div><h3>{item.title}</h3><p class="muted">{item.excerpt}</p><span class="arrow-link">Baca cerita <span>↗</span></span></a>{item.demo&&<p class="muted" style="font-size:10px;margin-top:12px">Konten contoh</p>}</article>
