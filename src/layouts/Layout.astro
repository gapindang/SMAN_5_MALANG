---
import Icon from '../components/Icon.astro';
import '../lib/styles.css';
import {school} from '../lib/school';
const {title=school.name,description=school.description,image=school.hero,noindex=false}=Astro.props;
const path=Astro.url.pathname;
const nav=[['/','Beranda'],['/profil','Profil Sekolah'],['/berita','Berita'],['/majalah','Majalah'],['/kontak','Kontak']];
---
<!doctype html><html lang="id"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} · Ruang untuk Bertumbuh</title><meta name="description" content={description}/><link rel="icon" type="image/svg+xml" href="/school-icon.svg"/><link rel="canonical" href={new URL(path,Astro.site)}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={new URL(image,Astro.site)}/><meta property="og:type" content="website"/>{noindex&&<meta name="robots" content="noindex,nofollow"/>}</head><body><a class="skip" href="#main">Langsung ke konten</a><div class="topbar"><div class="wrap"><span>Belajar hari ini. Menginspirasi esok hari.</span><span>Ruang informasi & cerita sekolah <span aria-hidden="true"><Icon name="arrow-up-right"/></span></span></div></div><header class="wrap glass-header" data-site-header><a href="/" class="brand"><img src="/logo-SMAN-5-200x300.png" alt="" width="42" height="42"/><span>{school.name}<small>BERAKAR KUAT, TUMBUH HEBAT</small></span></a><nav aria-label="Navigasi utama" id="navigation"><span class="nav-indicator" aria-hidden="true"></span>{nav.map(([href,label],index)=><a href={href} aria-current={(href==='/'?path==='/':path.startsWith(href))?'page':undefined}><span class="nav-index" aria-hidden="true">0{index+1}</span><span>{label}</span><span class="nav-arrow" aria-hidden="true"><Icon name="arrow-up-right"/></span></a>)}</nav><a href="/profil#visi" class="header-cta">Kenali Kami <span aria-hidden="true"><Icon name="arrow-up-right"/></span></a><button class="menu" type="button" aria-controls="navigation" aria-expanded="false" aria-label="Buka navigasi"><span class="menu-caption">Menu</span><span class="menu-open"><Icon name="menu"/></span><span class="menu-close"><Icon name="x"/></span></button></header><button class="nav-backdrop" type="button" aria-label="Tutup navigasi" tabindex="-1" hidden></button><main id="main"><slot/></main><footer><div class="wrap footer-grid"><div><a href="/" class="brand"><img src="/logo-SMAN-5-200x300.png" alt="" width="38" height="38"/><span>{school.name}<small>BERAKAR KUAT, TUMBUH HEBAT</small></span></a><p>Tempat tumbuhnya pengetahuan,<br/>karakter, dan mimpi-mimpi besar.</p></div><div><h3>Jelajahi</h3><a href="/profil">Profil Sekolah</a><a href="/berita">Cerita & Berita</a><a href="/majalah">Majalah Digital</a></div><div><h3>Mari terhubung</h3><p><a class="location-link" href={school.mapUrl} target="_blank" rel="noopener noreferrer">{school.address} <span aria-hidden="true"><Icon name="arrow-up-right"/></span></a></p><a href="/kontak">Informasi kontak <span><Icon name="arrow-up-right"/></span></a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} {school.name}. Ruang untuk bertumbuh.</span><a href="/adminlog"><Icon name="lock-keyhole" size={16}/> Ruang Admin <Icon name="arrow-right" size={16}/></a></div></footer><script>
import {initializeNavigation} from '../lib/navigation';
initializeNavigation();
document.querySelectorAll('img').forEach(img=>img.addEventListener('error',()=>{if(!img.dataset.fallback){img.dataset.fallback='1';img.src='/image-fallback.svg';}}));
</script></body></html>
<style>
.topbar{background:#e9e7db;font-size:10px;color:#606653}.topbar .wrap{display:flex;justify-content:space-between;padding-top:10px;padding-bottom:10px}
header.glass-header{position:sticky;top:12px;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:20px;height:84px;width:calc(100% - 48px);max-width:1272px;margin:14px auto 0;padding:0 26px;border:1px solid #fffdf5dd;border-radius:23px;background:#f5f0e6dd;backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);box-shadow:0 8px 30px #30382d08;transition:height .3s,background .3s,box-shadow .3s,border-color .3s}
header.is-scrolled{height:72px;background:#f5f0e6f0;border-color:#d5dcc7;box-shadow:0 12px 36px #30382d14}
.brand{display:flex;align-items:center;gap:12px;font:26px var(--font-display);min-width:0}.brand small{font:7px var(--font-sans);letter-spacing:.17em;display:block;margin-top:6px}.brand img{flex-shrink:0;object-fit:cover;border-radius:50%;transition:transform .45s}.brand:hover img{transform:rotate(-12deg)}
nav{position:relative;display:flex;gap:3px;padding:5px;background:#e0e5d53d;border:1px solid #d6deca80;border-radius:35px;font-size:11px;isolation:isolate}nav a{position:relative;z-index:1;display:flex;align-items:center;gap:6px;padding:12px 16px;border-radius:30px;color:#58604f;white-space:nowrap;transition:color .25s}nav a[aria-current=page]{color:#30382d;font-weight:600;background:#dce3cd}nav.indicator-ready a[aria-current=page]{background:transparent}.nav-indicator{display:none;position:absolute;z-index:0;top:5px;bottom:5px;left:0;border:1px solid #ffffffb3;border-radius:28px;background:linear-gradient(120deg,#dce3cd,#e7e9dc);box-shadow:0 3px 8px #30382d09;transition:transform .32s cubic-bezier(.2,.75,.3,1),width .32s cubic-bezier(.2,.75,.3,1),opacity .2s;pointer-events:none}nav.indicator-ready .nav-indicator{display:block}.nav-index,.nav-arrow{display:none}
.header-cta{border:1px solid #a5af93;border-radius:30px;background:#e0e5d550;padding:13px 17px;font-size:10px;display:flex;align-items:center;gap:20px;white-space:nowrap;transition:background .25s,box-shadow .25s}.header-cta span{transition:transform .25s}.header-cta:hover{background:#dbe2ce;box-shadow:0 5px 14px #30382d10}.header-cta:hover span{transform:translate(2px,-2px)}.menu{display:none}.nav-backdrop[hidden]{display:none}.nav-backdrop{position:fixed;inset:0;z-index:29;border:0;background:#30382d33;backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);animation:backdrop-in .2s ease}
footer{background:#30382d;color:#f5f0e6;padding-top:64px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1.4fr;gap:50px;padding-bottom:60px}footer p{font-size:12px;color:#d1d3c4;margin:22px 0 0}footer h3{font:11px var(--font-sans);text-transform:uppercase;letter-spacing:.12em;margin-bottom:24px}.footer-grid>div>a:not(.brand){display:block;font-size:12px;margin-top:14px}.footer-bottom{display:flex;flex-wrap:wrap;justify-content:space-between;border-top:1px solid #59604f;padding-top:20px;padding-bottom:20px;font-size:10px;color:#d1d3c4}
@keyframes backdrop-in{from{opacity:0}to{opacity:1}}
@media(max-width:1150px){.brand{font-size:18px}.header-cta{display:none}nav a{padding:12px 15px}}
@media(max-width:900px){header.glass-header{top:8px;height:auto;min-height:74px;flex-wrap:wrap;width:calc(100% - 24px);margin-top:10px;padding:14px 17px;border-radius:19px;gap:14px}.brand{font-size:18px}.brand small{font-size:6px}.brand img{width:36px;height:36px}.topbar .wrap>span:last-child{display:none}nav{width:100%;flex-direction:column;border-radius:14px;gap:5px;padding:10px}nav a{border-radius:10px;padding:14px;font-size:13px}.nav-index{display:inline;font-size:9px;margin-right:12px;color:#69785c}.nav-arrow{display:inline-block;margin-left:auto;font-size:17px;color:#69785c;transition:transform .25s}.nav-indicator{display:none!important}nav.indicator-ready a[aria-current=page],nav a:hover{background:#dfe5d3}nav a:hover .nav-arrow{transform:translate(2px,-2px)}
header.nav-enhanced{height:74px;min-height:0;flex-wrap:nowrap}.nav-enhanced.is-scrolled{height:66px}.nav-enhanced nav{position:absolute;top:calc(100% + 10px);left:0;right:0;width:100%;background:#f5f0e6f5;backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border:1px solid #fffdf5;box-shadow:0 18px 40px #30382d20;border-radius:18px;opacity:0;visibility:hidden;transform:translateY(-9px) scale(.98);transform-origin:top center;transition:opacity .22s,transform .22s,visibility .22s;pointer-events:none}.nav-enhanced nav.open{opacity:1;visibility:visible;transform:translateY(0) scale(1);pointer-events:auto}.nav-enhanced .menu{flex-shrink:0;display:flex;align-items:center;gap:12px;padding:11px 13px;border:1px solid #a5af93;border-radius:30px;background:#e0e5d550;color:#30382d;transition:background .25s}.menu:hover,.menu[aria-expanded=true]{background:#dce3cd}.menu-caption{font-size:10px}.menu-open,.menu-close{display:flex}.menu-close{display:none}.menu[aria-expanded=true] .menu-open{display:none}.menu[aria-expanded=true] .menu-close{display:flex}.nav-enhanced nav a{transform:translateY(-4px);transition:transform .25s,background .2s}.nav-enhanced nav.open a{transform:translateY(0)}.nav-enhanced nav.open a:nth-of-type(2){transition-delay:.025s}.nav-enhanced nav.open a:nth-of-type(3){transition-delay:.05s}.nav-enhanced nav.open a:nth-of-type(4){transition-delay:.075s}.nav-enhanced nav.open a:nth-of-type(5){transition-delay:.1s}
.footer-grid{grid-template-columns:1fr;gap:35px}.footer-bottom{gap:24px;align-items:center}}
@media(max-width:400px){.menu-caption{display:none}.brand{font-size:16px;gap:8px}.brand img{width:30px;height:30px}.brand small{font-size:5px}.nav-enhanced .menu{padding:10px;gap:8px}}
@media(max-width:900px){.nav-enhanced nav{max-height:calc(100dvh - 150px);overflow-y:auto;overscroll-behavior:contain}.brand>span{min-width:0}.brand small{line-height:1.6}.nav-enhanced .menu{min-width:44px;min-height:44px;justify-content:center}.footer-bottom>a{min-height:44px;display:inline-flex;align-items:center}}
@media(prefers-reduced-motion:reduce){header.glass-header,header.glass-header *,header.glass-header *:before,.nav-backdrop{animation:none!important;transition:none!important}.brand:hover img{transform:none}}
@supports not (backdrop-filter:blur(10px)){header.glass-header{background:#f5f0e6}.nav-enhanced nav{background:#f5f0e6}}
</style>
